{
  "name": "itacan",
  "productName": "Itacan",
  "version": "0.3.2",
  "private": true,
  "description": "A private local library for projects and research notes",
  "main": "main/app.cjs",
  "scripts": {
    "start": "electron . --itacan-dev",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:desktop": "npm run build && node test/desktop.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@fontsource/baskervville": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "codemirror": "6.0.2",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-texmath": "1.0.0",
    "playwright-core": "1.65.1"
  }
}
